rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function admin() {
      return googleUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function approved() {
      return googleUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    match /admins/{uid} {
      allow get: if googleUser() && request.auth.uid == uid;
      // Admin provisioning is only through a trusted project operator, never the browser.
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if googleUser() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email','name','status','createdAt','reviewedAt','reviewedBy'])
        && request.resource.data.keys().hasOnly(['email','name','status','createdAt','reviewedAt','reviewedBy'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null;
      allow update: if admin() && request.auth.uid != uid
        && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','denied']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
    match /portal/{document} {
      allow get: if document == 'directory' && (admin() || approved());
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
